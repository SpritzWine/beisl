# Copy to .env and edit. .env is gitignored — it holds the runner token.

# Where the persistent build cache lives ON THE HOST. Point this at the disk that has
# room: it holds the cargo registry plus BOTH target dirs, and the GUI tree
# (libcosmic/wgpu, ~630 crates, thin LTO) is the bulk of it. Budget ~10-15 GB.
# It is a pure cache — delete it any time to reclaim the space.
CACHE_DIR=/mnt/bigdisk/ci-cache/beisl

# From Codeberg -> beisl repo -> Settings -> Actions -> Runners -> "Create new runner".
# (Settings -> Units must have Actions enabled first.) The dialog hands you exactly
# these two values; paste them here. There is no separate `register` step in v12.
FORGEJO_UUID=
FORGEJO_TOKEN=

# Defaults are fine below this line.
FORGEJO_URL=https://codeberg.org/
RUNNER_NAME=beisl-runner

# The label `runs-on:` selects in .forgejo/workflows/release.yml. The part after
# docker:// is only the fallback image for jobs that don't name their own container.
RUNNER_LABELS=beisl-local:docker://docker.io/library/rust:1
