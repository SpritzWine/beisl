# Copy to .env and edit. .env is gitignored — it holds the runner token.

# Where the persistent build cache lives ON THE HOST. Point this at the disk that has
# room: it holds the cargo registry plus BOTH target dirs, and the GUI tree
# (libcosmic/wgpu, ~630 crates, thin LTO) is the bulk of it. Budget ~10-15 GB.
#
# If this runner ALSO builds SpritzWine-Prater, add ~60 GB: Prater keeps a warm Proton
# work tree (~25-30 GB by itself) plus ccache, because a cold Proton build is hours.
# It is a pure cache — delete it any time to reclaim the space.
CACHE_DIR=/mnt/bigdisk/ci-cache

# From Codeberg's "Create new runner" dialog (Settings -> Units must have Actions enabled
# first). It hands you exactly these two values; paste them here. There is no separate
# `register` step in v12.
#
# WHERE you create the runner decides which repos it may serve, and no label can change
# it afterwards:
#   * <repo> -> Settings -> Actions -> Runners  = repo-scoped: serves ONLY that repo.
#   * <org>  -> Settings -> Actions -> Runners  = ORG-scoped: serves every repo in the
#     org (beisl, SpritzWine, SpritzWine-Prater, wine) from this one box.
# A repo-scoped runner silently ignores the other repos' jobs — they queue forever with
# no error. Create it from the ORG page.
FORGEJO_UUID=
FORGEJO_TOKEN=

# Defaults are fine below this line.
FORGEJO_URL=https://codeberg.org/
RUNNER_NAME=spritzwine-runner

# The labels a workflow's `runs-on:` selects. The part after docker:// is only the
# FALLBACK image for jobs that do not name their own container (all of ours do).
#
# `force_pull: false` in data/config.template.yml means a locally built image tag is used
# as-is and is never pulled from a registry — which is what lets the two build images
# below exist only on this host. Build them here:
#
#   # in a SpritzWine-Prater checkout:
#   docker build -t spritzwine-prater-build:steamrt4 -f prater/build-env.Dockerfile prater/
#   # in a SpritzWine checkout:
#   docker build -t spritzwine-build:fedora44 -f ci/build-env.Dockerfile ci/
#
# Drop the labels you do not serve — a beisl-only runner needs just the first.
RUNNER_LABELS=beisl-local:docker://docker.io/library/rust:1,spritzwine-local:docker://spritzwine-build:fedora44,prater-local:docker://spritzwine-prater-build:steamrt4

# Options handed to every job container.
#
#   -v @CACHE_DIR@:/cache         the persistent cache (@CACHE_DIR@ expands to CACHE_DIR)
#   --device /dev/ntsync          REQUIRED for Prater: its smoke gate runs the PE sync
#                                 fixtures under BOTH wine sync backends, and without this
#                                 device the ntsync lane skips (loudly, without failing),
#                                 leaving the sync backend unguarded — the one thing this
#                                 project has already misdiagnosed once. Needs a >= 6.14
#                                 kernel on the host. Drop it if you do not build Prater.
#   --security-opt label=disable  SELinux hosts (Fedora/RHEL): without it a job cannot
#                                 write the bind-mounted cache. Harmless elsewhere.
CONTAINER_OPTIONS=-v @CACHE_DIR@:/cache --device /dev/ntsync --security-opt label=disable

# Max wall-clock for a single job. 6h fits beisl comfortably. A COLD Proton build (wine
# for both arches, dxvk, vkd3d-proton, ffmpeg, icu) is hours — give it room the first
# time; every build after that is warm.
JOB_TIMEOUT=12h
