<services>
  <!-- Vendors BOTH workspaces: crates/beisl-gui is excluded from the root one
       and has its own lockfile, so a single run would miss the ~48 git
       dependencies libcosmic pins. -->
  <service name="cargo_vendor" mode="manual">
    <param name="srcdir">beisl</param>
    <param name="compression">zst</param>
    <param name="update">false</param>
  </service>
  <service name="cargo_audit" mode="manual">
    <param name="srcdir">beisl</param>
  </service>
</services>
